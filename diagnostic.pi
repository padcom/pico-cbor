// Diagnostic notation (RFC 8949 §8): a CBOR item as text, for tests and logs.
import { hex } from "std/encoding"
import { Cbor } from "./cbor"

/// How `diagnostic` writes floats: as numbers (default: `1.5`, `NaN`, `Infinity`), or with
/// `floatBits` as their IEEE double bits (`float(0x3ff8000000000000)`, NaN canonical), which
/// language-neutral test vectors compare exactly.
export struct DiagnosticOptions {
  floatBits?: bool
}

function quote(s: string): string {
  return `"${s.replaceAll("\\", "\\\\").replaceAll("\"", "\\\"")}"`
}

function number(f: f64): string {
  if (f != f) {
    return "NaN"
  }
  if (f == 1.0 / 0.0) {
    return "Infinity"
  }
  if (f == -1.0 / 0.0) {
    return "-Infinity"
  }
  const s = `${f}`
  if (s.includes(".") || s.includes("e")) s else if (f == 0.0 && 1.0 / f < 0.0) "-0.0" else `${s}.0`
}

function bits(f: f64): string {
  if (f != f) {
    return "float(0x7ff8000000000000)"
  }
  const b = new Uint8Array(8)
  new DataView(b).setFloat64(0, f)
  return `float(0x${hex.encode(b)})`
}

/// `v` in diagnostic notation: integers in decimal, `h'..'` bytes, quoted text, `[..]`, `{k: v}`
/// in order, `tag(value)`, `true`/`false`/`null`/`undefined`, `simple(n)`.
export function diagnostic(v: Cbor, options: DiagnosticOptions = {}): string {
  match (v) {
    Uint { value } => `${value}`,
    Negative { value } => if (value == 18446744073709551615) "-18446744073709551616" else `-${value + 1}`,
    Bytes { value } => `h'${hex.encode(value)}'`,
    Text { value } => quote(value),
    List { items } => `[${items.map((i: Cbor): string => diagnostic(i, options)).join(", ")}]`,
    Dict { entries } => {
      const parts: string[] = []
      for (const [k, e] of entries) {
        parts.push(`${quote(k)}: ${diagnostic(e, options)}`)
      }
      `{${parts.join(", ")}}`
    },
    Keyed { entries } => {
      const parts: string[] = []
      for (const [k, e] of entries) {
        parts.push(`${k}: ${diagnostic(e, options)}`)
      }
      `{${parts.join(", ")}}`
    },
    Pairs { entries } => {
      const parts: string[] = []
      for (const e of entries) {
        parts.push(`${diagnostic(e.key, options)}: ${diagnostic(e.value, options)}`)
      }
      `{${parts.join(", ")}}`
    },
    Tag { item } => `${item.tag}(${diagnostic(item.value, options)})`,
    Bool { value } => `${value}`,
    Null => "null",
    Undefined => "undefined",
    Simple { value } => `simple(${value})`,
    Float { value } => if (options.floatBits == true) bits(value) else number(value),
  }
}
